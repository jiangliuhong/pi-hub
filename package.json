{
  "name": "@jarome/pi-hub",
  "version": "0.0.9",
  "description": "Web UI for the pi coding agent (pi-hub fork of pi-web, with scheduler, Telegram and notification integrations)",
  "homepage": "https://github.com/jiangliuhong/pi-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangliuhong/pi-hub.git"
  },
  "bugs": {
    "url": "https://github.com/jiangliuhong/pi-hub/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-hub": "bin/pi-hub.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "docs/screenshots",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30142",
    "dev:lan": "next dev -H 0.0.0.0 -p 30142",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30142",
    "start:lan": "next start -H 0.0.0.0 -p 30142",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"modules/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "cron-parser": "^5.7.0",
    "grammy": "^1.45.1",
    "js-yaml": "^5.2.3",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
